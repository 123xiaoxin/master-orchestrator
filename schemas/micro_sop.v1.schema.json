{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/123xiaoxin/master-orchestrator/schemas/micro_sop.v1.schema.json",
  "title": "Master Orchestrator Micro SOP v1",
  "description": "Per-agent dispatch contract defining grounded context, concrete deliverables, negative constraints, exit conditions, and bounded runtime.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "context",
    "deliverable",
    "negativeConstraints",
    "exitCondition",
    "budget"
  ],
  "properties": {
    "schemaVersion": {
      "const": "micro_sop.v1"
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "deliverable": {
      "type": "string",
      "minLength": 1
    },
    "negativeConstraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exitCondition": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "heartbeat"
      ],
      "properties": {
        "tokenBudget": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxRounds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "timeoutMinutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "heartbeat": {
          "const": 0
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "micro_sop.v1",
      "context": "Read the accepted requirements and relevant files.",
      "deliverable": "Return the requested artifact and verification evidence.",
      "negativeConstraints": ["Do not modify unrelated files."],
      "exitCondition": "The deliverable satisfies every success criterion.",
      "budget": {
        "tokenBudget": null,
        "maxRounds": 2,
        "timeoutMinutes": 20,
        "heartbeat": 0
      }
    }
  ]
}
